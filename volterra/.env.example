# VOLTERRA MVP - PLACEHOLDERS (SIN SECRETOS)
SUPABASE_URL=https://tioeoswnhwrlbovkxocd.supabase.co
# Clave pública: usa la legacy `anon` (JWT `eyJ…`, role=anon). Verificado el 12/11/2026:
# GoTrue rechaza la `sb_publishable_…` en /auth/v1/token con 401 Invalid API key.
SUPABASE_PUBLISHABLE_KEY=your_anon_key_here
# La aplicación NO lee SUPABASE_SERVICE_ROLE_KEY. No la configures para el BFF.
# SUPABASE_JWT_SECRET=        # Solo si se usa HS256. Verificar issuer/audience/exp siempre.
# SUPABASE_JWT_ISSUER=https://tioeoswnhwrlbovkxocd.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated
# CORS_ORIGINS admite lista JSON o valores separados por comas.
APP_ENV=dev
APP_NAME=volterra-mvp
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Hosts aceptados (TrustedHost). "*" solo en desarrollo: en prod el arranque falla.
# TRUSTED_HOSTS=localhost,127.0.0.1
# Vacío = derivado de APP_ENV (docs solo fuera de producción).
# ENABLE_DOCS=true
SECURE_HEADERS=true
# La demo local usa HTTP; en producción debe ser true (cookies Secure).
COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SUPABASE_AUTH_TIMEOUT_SECONDS=10
# Timeout de PostgREST por petición. Los reintentos solo aplican a GET/HEAD.
SUPABASE_POSTGREST_TIMEOUT_SECONDS=15

# --- Límite de peticiones (DEC-22, ADR-015) ---------------------------------
# Ventana fija en memoria por proceso. Perfil estricto por defecto.
RATE_LIMIT_ENABLED=true
# Solo activar detrás de un proxy propio que añada la IP del cliente al final.
RATE_LIMIT_TRUST_FORWARDED_FOR=false
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_REFRESH_ATTEMPTS=15
RATE_LIMIT_REFRESH_WINDOW_SECONDS=300
RATE_LIMIT_LOGOUT_ATTEMPTS=15
RATE_LIMIT_LOGOUT_WINDOW_SECONDS=300
RATE_LIMIT_ANON_WRITE_REQUESTS=15
RATE_LIMIT_WRITE_REQUESTS=15
RATE_LIMIT_WRITE_WINDOW_SECONDS=60
RATE_LIMIT_READ_REQUESTS=120
RATE_LIMIT_READ_WINDOW_SECONDS=60

# --- Logging estructurado ---------------------------------------------------
# json: una línea JSON por evento. text: formato legible para desarrollo.
LOG_FORMAT=json
LOG_LEVEL=INFO
